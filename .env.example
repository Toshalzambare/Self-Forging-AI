# ============================================================
# Self-Forging AI Agent - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ============================================================

# OmniRoute / LLM Gateway Configuration
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-placeholder-omniroute-key-example-12345
OMNIROUTE_MODEL=auto
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# Autonomous Web Research & Documentation Retrieval
SEARCH_PROVIDER=duckduckgo  # Options: duckduckgo, searxng, tavily, mock
SEARCH_MAX_RESULTS=3
SEARCH_TIMEOUT_SECONDS=10
SEARCH_USER_AGENT="SelfForgingAI/1.0 (Autonomous Documentation Research; +https://github.com/Toshalzambare/Self-Forging-AI)"

# Novel Hybrid Tool Search Algorithm Weights & Thresholds
HYBRID_SEARCH_THRESHOLD=0.65
HYBRID_WEIGHT_INTENT=0.50
HYBRID_WEIGHT_STRUCT=0.35
HYBRID_WEIGHT_PERF=0.15

# Docker Sandbox Configuration
# Pre-cached Python test sandbox with pytest & common dependencies baked in
DOCKER_SANDBOX_IMAGE=sfa-sandbox:latest
DOCKER_SANDBOX_TIMEOUT=60
DOCKER_SANDBOX_MEMORY_LIMIT=512m
DOCKER_SANDBOX_NETWORK=bridge

# PostgreSQL 16 Database Configuration
POSTGRES_DB=sfa_db
POSTGRES_USER=sfa_user
POSTGRES_PASSWORD=changeme_random_32_chars
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://sfa_user:changeme_random_32_chars@localhost:5432/sfa_db

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123_change_in_prod
MINIO_BUCKET_TOOLS=tool-archives
MINIO_BUCKET_DOCS=user-documents
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000

# JWT & Session Security
JWT_SECRET_KEY=generate_a_random_32_char_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 Credentials (see docs/GOOGLE_OAUTH_SETUP_GUIDE.md)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
ALLOW_MOCK_GOOGLE_AUTH=false  # Set to true ONLY in local dev/testing to permit mock tokens
MOCK_GOOGLE_DOMAINS=@example.test,@example.com,@test.local

# Network & Reverse Proxy Security
TRUSTED_PROXIES=127.0.0.1,::1,localhost

# FastAPI Backend Configuration
APP_NAME="Self-Forging AI Agent"
APP_VERSION=0.1.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Dev Server Port
FRONTEND_PORT=5173
